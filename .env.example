# ── Supabase ─────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# ТОЛЬКО для серверного кода (webhooks). Никогда не коммитить и не использовать на клиенте.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Telegram Bots ────────────────────────────────────────────
# Токены от @BotFather
TELEGRAM_LEAD_BOT_TOKEN=your_lead_bot_token
TELEGRAM_INTERNAL_BOT_TOKEN=your_internal_bot_token
# Бот поддержки (опционально, можно тот же токен что и lead-bot)
TELEGRAM_SUPPORT_BOT_TOKEN=your_support_bot_token
# ID командного чата для уведомлений
TELEGRAM_INTERNAL_CHAT_ID=your_team_chat_id
# Секрет для проверки вебхуков (передаётся при setWebhook как secret_token). Опционально.
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_random_secret
